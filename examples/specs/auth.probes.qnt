// ==========================================================
// Requirement Probe Module: auth
// GENERATED by tools/spec-probes.py — regenerate, never hand-edit.
// Source: the @req records in specs/auth.qnt — each
// requirement's @while / @shall / @outcome, verbatim, as defs over its
// action's own parameters.
//
// Every requirement is checked twice:
//   oblig_<REQ>    its OBLIGATION, asserted positively: every reachable
//                  step of its action from a state where @while held
//                  ends where @shall holds (or never happens, for a
//                  forbidden one). A counterexample is a VIOLATION.
//   witness_<REQ>  the NEGATION of "such a step happened": the model
//                  checker's counterexample IS the witness trace, proof
//                  the obligation is not vacuous.
// _pre_<REQ> is set by stepP from the state BEFORE the step, so @while
// is read where the sentence says it holds. The path conjunct comes
// first: at init no action has run and no ghost may be read as a key.
//
// Parameters ride in one ghost per TYPE POSITION, not per name;
// spec-record writes every trace back under _last<Param> names.
// name -> slot, per action:
//   login: uid -> _arg_UserId_1, sid -> _arg_SessionId_1
//   logout: sid -> _arg_SessionId_1
//   login_failed: uid -> _arg_UserId_1
//   expire_session: sid -> _arg_SessionId_1
//   unlock_account: uid -> _arg_UserId_1
// ==========================================================

module auth_probes {

  import auth.* from "./auth"

  // -- Ghost instrumentation ---------------------------------
  var _lastAction: str
  var _arg_SessionId_1: SessionId
  var _arg_UserId_1: UserId
  var _pre_REQ_002: bool
  var _pre_REQ_003: bool
  var _pre_REQ_004: bool
  var _pre_REQ_005: bool
  var _pre_REQ_006: bool
  var _old_REQ_003_before: int
  var _prevAccountStatus: UserId -> AccountStatus
  var _prevFailedAttempts: UserId -> int
  var _prevSessions: SessionId -> SessionStatus

  // -- What each requirement says, over its action's parameters --
  def post_REQ_001(uid: UserId, sid: SessionId): bool =
    isActive(sid) and sessionOwner.get(sid) == uid and activeSessionsOf(uid).contains(sid) and attemptsOf(uid) == 0
  def pre_REQ_002(sid: SessionId): bool =
    isActive(sid)
  def post_REQ_002(sid: SessionId): bool =
    statusOf(sessions, sid) == LoggedOut
  def pre_REQ_003(uid: UserId): bool =
    not(isLocked(uid))
  def old_REQ_003_before(uid: UserId): int =
    attemptsOf(uid)
  def post_REQ_003(uid: UserId, before: int): bool =
    attemptsOf(uid) == before + 1 and (isLocked(uid) iff attemptsOf(uid) >= MAX_FAILED_ATTEMPTS)
  def pre_REQ_004(sid: SessionId): bool =
    isActive(sid) and idleOf(sid) > MAX_SESSION_AGE
  def post_REQ_004(sid: SessionId): bool =
    statusOf(sessions, sid) == Expired
  def pre_REQ_005(uid: UserId, sid: SessionId): bool =
    isLocked(uid)
  def pre_REQ_006(uid: UserId): bool =
    not(isLocked(uid))
  def post_REQ_006(uid: UserId): bool =
    isLocked(uid) implies sessions.keys().forall(s => sessionOwner.get(s) != uid or not(isActive(s)))

  action initP = all {
    init,
    _lastAction' = "init",
    _arg_SessionId_1' = "",
    _arg_UserId_1' = "",
    _pre_REQ_002' = false,
    _pre_REQ_003' = false,
    _pre_REQ_004' = false,
    _pre_REQ_005' = false,
    _pre_REQ_006' = false,
    _old_REQ_003_before' = 0,
    _prevAccountStatus' = Map(),
    _prevFailedAttempts' = Map(),
    _prevSessions' = Map(),
  }

  action stepP = {
    nondet arg_SessionId_1 = oneOf(Set("s1", "s2"))
    nondet arg_UserId_1 = oneOf(Set("alice", "bob"))
    any {
      all { login(arg_UserId_1, arg_SessionId_1),
            _lastAction' = "login",
            _arg_SessionId_1' = arg_SessionId_1,
            _arg_UserId_1' = arg_UserId_1,
            _pre_REQ_002' = false,
            _pre_REQ_003' = false,
            _pre_REQ_004' = false,
            _pre_REQ_005' = pre_REQ_005(arg_UserId_1, arg_SessionId_1),
            _pre_REQ_006' = false,
            _old_REQ_003_before' = _old_REQ_003_before,
            _prevAccountStatus' = accountStatus,
            _prevFailedAttempts' = failedAttempts,
            _prevSessions' = sessions,
      },
      all { logout(arg_SessionId_1),
            _lastAction' = "logout",
            _arg_SessionId_1' = arg_SessionId_1,
            _arg_UserId_1' = _arg_UserId_1,
            _pre_REQ_002' = pre_REQ_002(arg_SessionId_1),
            _pre_REQ_003' = false,
            _pre_REQ_004' = false,
            _pre_REQ_005' = false,
            _pre_REQ_006' = false,
            _old_REQ_003_before' = _old_REQ_003_before,
            _prevAccountStatus' = accountStatus,
            _prevFailedAttempts' = failedAttempts,
            _prevSessions' = sessions,
      },
      all { login_failed(arg_UserId_1),
            _lastAction' = "login_failed",
            _arg_SessionId_1' = _arg_SessionId_1,
            _arg_UserId_1' = arg_UserId_1,
            _pre_REQ_002' = false,
            _pre_REQ_003' = pre_REQ_003(arg_UserId_1),
            _pre_REQ_004' = false,
            _pre_REQ_005' = false,
            _pre_REQ_006' = pre_REQ_006(arg_UserId_1),
            _old_REQ_003_before' = old_REQ_003_before(arg_UserId_1),
            _prevAccountStatus' = accountStatus,
            _prevFailedAttempts' = failedAttempts,
            _prevSessions' = sessions,
      },
      all { expire_session(arg_SessionId_1),
            _lastAction' = "expire_session",
            _arg_SessionId_1' = arg_SessionId_1,
            _arg_UserId_1' = _arg_UserId_1,
            _pre_REQ_002' = false,
            _pre_REQ_003' = false,
            _pre_REQ_004' = pre_REQ_004(arg_SessionId_1),
            _pre_REQ_005' = false,
            _pre_REQ_006' = false,
            _old_REQ_003_before' = _old_REQ_003_before,
            _prevAccountStatus' = accountStatus,
            _prevFailedAttempts' = failedAttempts,
            _prevSessions' = sessions,
      },
      all { unlock_account(arg_UserId_1),
            _lastAction' = "unlock_account",
            _arg_SessionId_1' = _arg_SessionId_1,
            _arg_UserId_1' = arg_UserId_1,
            _pre_REQ_002' = false,
            _pre_REQ_003' = false,
            _pre_REQ_004' = false,
            _pre_REQ_005' = false,
            _pre_REQ_006' = false,
            _old_REQ_003_before' = _old_REQ_003_before,
            _prevAccountStatus' = accountStatus,
            _prevFailedAttempts' = failedAttempts,
            _prevSessions' = sessions,
      },
      all { tick,
            _lastAction' = "tick",
            _arg_SessionId_1' = _arg_SessionId_1,
            _arg_UserId_1' = _arg_UserId_1,
            _pre_REQ_002' = false,
            _pre_REQ_003' = false,
            _pre_REQ_004' = false,
            _pre_REQ_005' = false,
            _pre_REQ_006' = false,
            _old_REQ_003_before' = _old_REQ_003_before,
            _prevAccountStatus' = accountStatus,
            _prevFailedAttempts' = failedAttempts,
            _prevSessions' = sessions,
      },
    }
  }

  // -- Obligations: every reachable step ----------------------

  /// REQ-001: When a registered user submits valid credentials, the system shall create an Active session owned by that user.
  val oblig_REQ_001: bool =
    not(_lastAction == "login")
      or post_REQ_001(_arg_UserId_1, _arg_SessionId_1)

  /// REQ-002: While a user's session is Active, when the user requests logout, the system shall transition that session to LoggedOut.
  val oblig_REQ_002: bool =
    not(_lastAction == "logout" and _pre_REQ_002)
      or post_REQ_002(_arg_SessionId_1)

  /// REQ-003: If a login attempt fails while the account is Unlocked, then the system shall increment failedAttempts and lock the account when it reaches MAX_FAILED_ATTEMPTS.
  val oblig_REQ_003: bool =
    not(_lastAction == "login_failed" and _pre_REQ_003)
      or post_REQ_003(_arg_UserId_1, _old_REQ_003_before)

  /// REQ-004: While a session is Active and has been inactive for longer than MAX_SESSION_AGE, the system shall transition it to Expired.
  val oblig_REQ_004: bool =
    not(_lastAction == "expire_session" and _pre_REQ_004)
      or post_REQ_004(_arg_SessionId_1)

  /// REQ-005: While the account is Locked, if the user submits valid credentials, then the system shall refuse the login.
  val oblig_REQ_005: bool =
    not(_lastAction == "login" and _pre_REQ_005)

  /// REQ-006: If a failed login locks the account, then the system shall end the user's Active sessions.
  val oblig_REQ_006: bool =
    not(_lastAction == "login_failed" and _pre_REQ_006)
      or post_REQ_006(_arg_UserId_1)

  // -- Completeness: every step is one a requirement speaks to --

  /// Coverage of logout: every step is under REQ-002
  val cover_logout: bool =
    _lastAction != "logout"
      or _pre_REQ_002

  /// Explanation of sessions on logout: changed only where REQ-002 applied
  val explain_logout_sessions: bool =
    not(_lastAction == "logout" and sessions != _prevSessions)
      or _pre_REQ_002

  /// Coverage of login_failed: every step is under REQ-003, REQ-006
  val cover_login_failed: bool =
    _lastAction != "login_failed"
      or _pre_REQ_003

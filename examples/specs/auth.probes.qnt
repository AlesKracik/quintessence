// ============================================================
// Witness Probe Module: auth
// GENERATED by /spec-check — regenerate, never hand-edit.
// Source of predicates: requirements[].witness in specs/auth.area.json
//
// To prove a behavior is REACHABLE, assert its negation as an
// invariant — the checker's counterexample IS the witness trace.
//
// Each probe carries THREE conjuncts, and each closes a different
// way a witness can prove less than the requirement claims:
//
//   1. PREDICATE, bound to the param ghosts. `_lastAction` pins
//      which action ran last, not that it caused anything: a bare
//      existential is satisfied by a session some unrelated call
//      created, so the requirement goes green while its own
//      action misbehaves. Bound predicates say "of THIS session".
//   2. PATH CONSTRAINT (_lastAction == quint_ref) — the trace must
//      arrive via the requirement's own action.
//   3. DELTA over the _prev* ghosts — the pre-state the step had
//      to start from. Without it, a guard that already implies its
//      own postcondition makes the action a no-op that fires only
//      once its result holds, and dead text witnesses green.
//
//   quint verify --invariant=witness_REQ_003 \
//     --init=initP --step=stepP \
//     --out-itf=specs/auth/traces/REQ-003.itf.json \
//     specs/auth.probes.qnt
//
// "Violation found" => WITNESSED.  "No violation" => NO WITNESS
// (behavior unreachable — vacuity red flag).
// ============================================================

module auth_probes {

  import auth.* from "./auth"

  // -- Ghost instrumentation -----------------------------------
  // _lastAction: which action produced the current state.
  // _lastUid / _lastSid: its arguments — the replay harness reads
  //   these instead of inferring call parameters from state diffs,
  //   and the witness predicates bind to them.
  // _prev*: the pre-state snapshot the delta conjunct compares
  //   against. One per var some delta actually needs.

  var _lastAction: str
  var _lastUid: str
  var _lastSid: str
  var _prevSessions: SessionId -> SessionStatus
  var _prevAccountStatus: UserId -> AccountStatus

  action initP = all {
    init,
    _lastAction' = "init",
    _lastUid'    = "",
    _lastSid'    = "",
    // Explicit, not `= sessions`: before init there is no state to read.
    _prevSessions'      = Map(),
    _prevAccountStatus' = Map(),
  }

  action stepP = {
    nondet uid = oneOf(Set("alice", "bob", "charlie"))
    nondet sid = oneOf(Set("s1", "s2", "s3"))
    any {
      all { login(uid, sid),     _lastAction' = "login",
            _lastUid' = uid,       _lastSid' = sid,
            _prevSessions' = sessions, _prevAccountStatus' = accountStatus },
      all { logout(sid),         _lastAction' = "logout",
            _lastUid' = _lastUid,  _lastSid' = sid,
            _prevSessions' = sessions, _prevAccountStatus' = accountStatus },
      all { login_failed(uid),   _lastAction' = "login_failed",
            _lastUid' = uid,       _lastSid' = _lastSid,
            _prevSessions' = sessions, _prevAccountStatus' = accountStatus },
      all { expire_session(sid), _lastAction' = "expire_session",
            _lastUid' = _lastUid,  _lastSid' = sid,
            _prevSessions' = sessions, _prevAccountStatus' = accountStatus },
      all { unlock_account(uid), _lastAction' = "unlock_account",
            _lastUid' = uid,       _lastSid' = _lastSid,
            _prevSessions' = sessions, _prevAccountStatus' = accountStatus },
    }
  }

  // -- Witness probes (bound predicate ∧ acting step ∧ delta) ---

  /// Witness probe for REQ-001: login produces an Active session
  /// owned by the caller.
  val witness_REQ_001: bool =
    not(sessions.keys().contains(_lastSid)
        and statusOf(sessions, _lastSid) == Active
        and activeSessionsOf(_lastUid).contains(_lastSid)
        and _lastAction == "login"
        and not(_prevSessions.keys().contains(_lastSid)))

  /// Witness probe for REQ-002: logout ends the caller's session.
  val witness_REQ_002: bool =
    not(statusOf(sessions, _lastSid) == LoggedOut
        and _lastAction == "logout"
        and statusOf(_prevSessions, _lastSid) == Active)

  /// Witness probe for REQ-003: repeated failures lock the account
  /// that failed, and only from an unlocked starting point.
  val witness_REQ_003: bool =
    not(accountStatus.keys().contains(_lastUid)
        and accountStatus.get(_lastUid) == Locked
        and _lastAction == "login_failed"
        and not(_prevAccountStatus.keys().contains(_lastUid)
                and _prevAccountStatus.get(_lastUid) == Locked))

  /// Witness probe for REQ-004: an Active session expires.
  val witness_REQ_004: bool =
    not(statusOf(sessions, _lastSid) == Expired
        and _lastAction == "expire_session"
        and statusOf(_prevSessions, _lastSid) == Active)

  // REQ-005 has no probe by design: it forbids a behavior, and a
  // prohibition has no reachable state to witness. INV-002
  // (noSessionWhileLocked) carries its model-side proof, and its
  // code-side evidence is the refusal artifact named in
  // requirements[].refusal — replay never covers it, because
  // replay only replays witness traces.

  // Action coverage falls out of the witness probes: each one is
  // path-constrained (_lastAction == quint_ref), so a witnessed REQ
  // proves its action fires. Actions referenced by NO requirement
  // are flagged statically by spec-lint (orphan-action).
}

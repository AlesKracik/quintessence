// ==========================================================
// Witness Probe Module: auth
// GENERATED by tools/spec-probes.py — regenerate, never hand-edit.
// Source of predicates: the @req / @outcome-of doc comments in
// specs/auth.qnt — each witness host's body, inlined here.
// Transition invariants: the @inv hosts over _prev* ghosts, same file.
//
// To prove a behavior is REACHABLE, assert its negation as an
// invariant — the checker's counterexample IS the witness trace.
//
// Each probe carries up to THREE conjuncts, and each closes a
// different way a witness can prove less than the requirement claims:
//   1. PATH CONSTRAINT (_lastAction == quint_ref) — the trace must
//      arrive via the requirement's own action.
//   2. DELTA over the _prev* ghosts — the pre-state the step had to
//      start from. Without it a predicate already true at init
//      witnesses green over nothing; spec-record refuses that trace
//      as HOLLOW.
//   3. PREDICATE, bound to the param ghosts.
// The path comes first so that at init — no action yet, every ghost
// still its zero — evaluation stops before reading a ghost as a key.
// ==========================================================

module auth_probes {

  import auth.* from "./auth"

  // -- Ghost instrumentation ---------------------------------
  var _lastAction: str
  var _lastSid: SessionId
  var _lastUid: UserId
  var _prevAccountStatus: UserId -> AccountStatus
  var _prevSessions: SessionId -> SessionStatus

  action initP = all {
    init,
    _lastAction' = "init",
    _lastSid' = "",
    _lastUid' = "",
    _prevAccountStatus' = Map(),
    _prevSessions' = Map(),
  }

  action stepP = {
    nondet sid = oneOf(Set("s1", "s2"))
    nondet uid = oneOf(Set("alice", "bob"))
    any {
      all { login(uid, sid),
            _lastAction' = "login",
            _lastSid' = sid,
            _lastUid' = uid,
            _prevAccountStatus' = accountStatus,
            _prevSessions' = sessions,
      },
      all { logout(sid),
            _lastAction' = "logout",
            _lastSid' = sid,
            _lastUid' = _lastUid,
            _prevAccountStatus' = accountStatus,
            _prevSessions' = sessions,
      },
      all { login_failed(uid),
            _lastAction' = "login_failed",
            _lastSid' = _lastSid,
            _lastUid' = uid,
            _prevAccountStatus' = accountStatus,
            _prevSessions' = sessions,
      },
      all { expire_session(sid),
            _lastAction' = "expire_session",
            _lastSid' = sid,
            _lastUid' = _lastUid,
            _prevAccountStatus' = accountStatus,
            _prevSessions' = sessions,
      },
      all { unlock_account(uid),
            _lastAction' = "unlock_account",
            _lastSid' = _lastSid,
            _lastUid' = uid,
            _prevAccountStatus' = accountStatus,
            _prevSessions' = sessions,
      },
      all { tick,
            _lastAction' = "tick",
            _lastSid' = _lastSid,
            _lastUid' = _lastUid,
            _prevAccountStatus' = accountStatus,
            _prevSessions' = sessions,
      },
    }
  }

  // -- Witness probes -----------------------------------------

  /// Witness probe for REQ-001: When a registered user submits valid credentials, the system shall create an Active session owned by that user.
  val witness_REQ_001: bool =
    not(_lastAction == "login"
        and not(_prevSessions.keys().contains(_lastSid))
        and sessions.keys().contains(_lastSid) and statusOf(sessions, _lastSid) == Active and activeSessionsOf(_lastUid).contains(_lastSid))

  /// Witness probe for REQ-002: While a user's session is Active, when the user requests logout, the system shall transition that session to LoggedOut.
  val witness_REQ_002: bool =
    not(_lastAction == "logout"
        and statusOf(_prevSessions, _lastSid) == Active
        and statusOf(sessions, _lastSid) == LoggedOut)

  /// Witness probe for REQ-003: If a login attempt fails while the account is Unlocked, then the system shall increment failedAttempts and lock the account when it reaches MAX_FAILED_ATTEMPTS.
  val witness_REQ_003: bool =
    not(_lastAction == "login_failed"
        and not(_prevAccountStatus.keys().contains(_lastUid) and _prevAccountStatus.get(_lastUid) == Locked)
        and accountStatus.keys().contains(_lastUid) and accountStatus.get(_lastUid) == Locked)

  /// Witness probe for REQ-004: While a session is Active and has been inactive for longer than MAX_SESSION_AGE, the system shall transition it to Expired.
  val witness_REQ_004: bool =
    not(_lastAction == "expire_session"
        and statusOf(_prevSessions, _lastSid) == Active
        and statusOf(sessions, _lastSid) == Expired)

  // -- The same probes, the right way up ----------------------
  // For the simulator. `quint run --witnesses=<name>` counts the
  // runs in which a formula held at least once, and each probe above
  // is a negation, which holds at init. These count the runs that
  // reached each behavior: the vacuity pre-screen spec-record runs
  // before the model checker, and the example gate in CI.
  val reached_REQ_001: bool = not(witness_REQ_001)
  val reached_REQ_002: bool = not(witness_REQ_002)
  val reached_REQ_003: bool = not(witness_REQ_003)
  val reached_REQ_004: bool = not(witness_REQ_004)

  // No probe, by design or because one is owed:
  //   REQ-005: forbidden — proof is INV-002

}

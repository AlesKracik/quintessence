import Spec.Subscription.Model

/-!
# subscription: the Lean proofs

The model — `State`, `Action`, `init`, `apply` and every invariant — is
`Spec.Subscription.Model`, generated from `specs/subscription.qnt` by
`tools/lean_gen.py` and regenerated by `spec-record` whenever the Quint model
changes. This file holds only proofs. `spec-record` writes the statement each
must prove; the replay checks the generated model against the area's traces.
-/

namespace Spec.Subscription
open Quint

/-! ## INV-003, proven

As written INV-003 is not inductive: a state with `c` Active, billing OFF
and the last answer `Success` satisfies it, and `cancel_declined` takes
it to a violation. That state is unreachable — billing is on whenever a
customer is Active — and the proof says so: it proves the stronger
`strong` for every customer `status` holds, then weakens.

Only keys of `status` are constrained. The Lean model reads `default` from
a missing key where Quint would fail the step, so it may set other maps at
a customer `status` does not hold; the invariant never looks there. -/

def strong (s : State) : Prop :=
  ∀ c v, s.status.get? c = some v →
    (v = .Active → s.billingEnabled.get c = true) ∧
    (s.lastBillingResult.get c ≠ .Success → v = .Active)

/-- `init`, computed: the kernel evaluates the generated `init`. -/
theorem init_eq : init =
    { status               := ⟨[("alice", .Active), ("bob", .Active)]⟩
      billingEnabled       := ⟨[("alice", true), ("bob", true)]⟩
      accessUntilPeriodEnd := ⟨[("alice", false), ("bob", false)]⟩
      lastBillingResult    := ⟨[("alice", .Success), ("bob", .Success)]⟩
      unansweredTries      := ⟨[("alice", 0), ("bob", 0)]⟩
      notice               := ⟨[("alice", .NoNotice), ("bob", .NoNotice)]⟩ } := by
  decide

theorem strong_init : strong init := by
  rw [init_eq]
  intro c v h
  simp only [QMap.get, QMap.get?, getList?] at h ⊢
  by_cases ha : c = "alice" <;> by_cases hb : c = "bob" <;> simp_all

theorem strong_step : ∀ a s t, strong s → apply a s = some t → strong t := by
  intro a s t hs h
  cases a with
  | cancel_subscription c n =>
    simp only [apply] at h; split at h <;> simp at h; subst h
    intro d v hv
    by_cases hd : d = c
    · subst hd; simp at hv; subst hv; simp
    · simp [hd] at hv ⊢; exact hs d v hv
  | cancel_declined c =>
    simp only [apply] at h; split at h <;> simp at h; subst h
    rename_i hg
    intro d v hv
    by_cases hd : d = c
    · subst hd
      have hva : v = .Active := by
        rw [← QMap.get_of_get? hv]; simpa using hg
      subst hva
      simpa using (hs d .Active hv).1 rfl
    · simp [hd] at hv ⊢; exact hs d v hv
  | cancel_unanswered c timedOut =>
    simp only [apply] at h; split at h <;> simp at h; subst h
    rename_i hg
    intro d v hv
    by_cases hd : d = c
    · subst hd
      have hva : v = .Active := by
        rw [← QMap.get_of_get? hv]; simp at hg; exact hg.1
      subst hva
      simpa using (hs d .Active hv).1 rfl
    · simp [hd] at hv ⊢; exact hs d v hv
  | cancel_again c =>
    simp only [apply] at h; split at h <;> simp at h; subst h; exact hs
  | expire_period c =>
    simp only [apply] at h; split at h <;> simp at h; subst h
    rename_i hg
    intro d v hv
    by_cases hd : d = c
    · subst hd; simp at hv; subst hv
      -- `c` is Cancelled (not the default), so `status` holds it, and a
      -- Cancelled customer's last answer was Success
      have hc : s.status.get? d = some .Cancelled := by
        have hg' : s.status.get d = .Cancelled := by simpa using hg
        unfold QMap.get at hg'
        cases hx : s.status.get? d with
        | none => simp [hx] at hg'
        | some w => simp [hx] at hg'; simp [hg']
      have h2 := (hs d .Cancelled hc).2
      refine ⟨by simp, fun hne => absurd (h2 hne) (by decide)⟩
    · simp [hd] at hv ⊢; exact hs d v hv
  | request_refund c => simp [apply] at h

theorem unacceptedCancelLeavesActive_holds :
    ∀ s, Reachable init apply s → unacceptedCancelLeavesActive s = true := by
  intro s hr
  have hs := Reachable.induct strong strong_init strong_step s hr
  simp only [unacceptedCancelLeavesActive, QMap.keySet, QSet.all, List.all_eq_true]
  intro c hc
  obtain ⟨v, hv⟩ := QMap.get?_of_mem_keys hc
  obtain ⟨h1, h2⟩ := hs c v hv
  by_cases h : s.lastBillingResult.get c = .Success
  · simp [h]
  · have ha := h2 h; subst ha
    simp [QMap.get_of_get? hv, h1 rfl]

end Spec.Subscription

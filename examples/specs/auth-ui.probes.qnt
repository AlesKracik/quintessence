// ==========================================================
// Requirement Probe Module: auth-ui
// GENERATED by tools/spec-probes.py — regenerate, never hand-edit.
// Source: the @req records in specs/auth-ui.qnt — each
// requirement's @while / @shall / @outcome, verbatim, as defs over its
// action's own parameters.
//
// Every requirement is checked twice:
//   oblig_<REQ>    its OBLIGATION, asserted positively: every reachable
//                  step of its action from a state where @while held
//                  ends where @shall holds (or never happens, for a
//                  forbidden one). A counterexample is a VIOLATION.
//   witness_<REQ>  the NEGATION of "such a step happened": the model
//                  checker's counterexample IS the witness trace, proof
//                  the obligation is not vacuous.
// _pre_<REQ> is set by stepP from the state BEFORE the step, so @while
// is read where the sentence says it holds. The path conjunct comes
// first: at init no action has run and no ghost may be read as a key.
// ==========================================================

module authUi_probes {

  import authUi.* from "./auth-ui"

  // -- Ghost instrumentation ---------------------------------
  var _lastAction: str
  var _lastS: SessionId
  var _lastU: UserId
  var _pre_UI_001: bool
  var _pre_UI_002: bool
  var _pre_UI_003: bool
  var _pre_UI_004: bool

  // -- What each requirement says, over its action's parameters --
  val pre_UI_001: bool =
    current == Home
  val post_UI_001: bool =
    current == Login
  def pre_UI_002(u: UserId, s: SessionId): bool =
    current == Login
  def post_UI_002(u: UserId, s: SessionId): bool =
    current == Dashboard and authenticated and mySession == s
  def pre_UI_003(u: UserId): bool =
    current == Login
  def post_UI_003(u: UserId): bool =
    current == LockedNotice and form == ErrorLocked and accountLocked(u)
  val pre_UI_004: bool =
    current == Dashboard
  val post_UI_004: bool =
    current == Login and not(authenticated)

  action initP = all {
    init,
    _lastAction' = "init",
    _lastS' = "",
    _lastU' = "",
    _pre_UI_001' = false,
    _pre_UI_002' = false,
    _pre_UI_003' = false,
    _pre_UI_004' = false,
  }

  action stepP = {
    nondet s = oneOf(Set("s1", "s2"))
    nondet u = oneOf(Set("alice", "bob"))
    any {
      all { click_sign_in,
            _lastAction' = "click_sign_in",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _pre_UI_001' = pre_UI_001,
            _pre_UI_002' = false,
            _pre_UI_003' = false,
            _pre_UI_004' = false,
      },
      all { submit_success(u, s),
            _lastAction' = "submit_success",
            _lastS' = s,
            _lastU' = u,
            _pre_UI_001' = false,
            _pre_UI_002' = pre_UI_002(u, s),
            _pre_UI_003' = false,
            _pre_UI_004' = false,
      },
      all { submit_invalid(u),
            _lastAction' = "submit_invalid",
            _lastS' = _lastS,
            _lastU' = u,
            _pre_UI_001' = false,
            _pre_UI_002' = false,
            _pre_UI_003' = false,
            _pre_UI_004' = false,
      },
      all { submit_locked(u),
            _lastAction' = "submit_locked",
            _lastS' = _lastS,
            _lastU' = u,
            _pre_UI_001' = false,
            _pre_UI_002' = false,
            _pre_UI_003' = pre_UI_003(u),
            _pre_UI_004' = false,
      },
      all { click_logout,
            _lastAction' = "click_logout",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _pre_UI_001' = false,
            _pre_UI_002' = false,
            _pre_UI_003' = false,
            _pre_UI_004' = false,
      },
      all { session_expired,
            _lastAction' = "session_expired",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _pre_UI_001' = false,
            _pre_UI_002' = false,
            _pre_UI_003' = false,
            _pre_UI_004' = pre_UI_004,
      },
      all { go_home,
            _lastAction' = "go_home",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _pre_UI_001' = false,
            _pre_UI_002' = false,
            _pre_UI_003' = false,
            _pre_UI_004' = false,
      },
      all { time_passes,
            _lastAction' = "time_passes",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _pre_UI_001' = false,
            _pre_UI_002' = false,
            _pre_UI_003' = false,
            _pre_UI_004' = false,
      },
    }
  }

  // -- Obligations: every reachable step ----------------------

  /// UI-001: While on Home, when the user clicks 'Sign in', the system shall navigate to Login.
  val oblig_UI_001: bool =
    not(_lastAction == "click_sign_in" and _pre_UI_001)
      or post_UI_001

  /// UI-002: While on Login, when the user submits valid credentials, the system shall navigate to Dashboard.
  val oblig_UI_002: bool =
    not(_lastAction == "submit_success" and _pre_UI_002)
      or post_UI_002(_lastU, _lastS)

  /// UI-003: If the user submits credentials for a Locked account, then the system shall navigate to LockedNotice.
  val oblig_UI_003: bool =
    not(_lastAction == "submit_locked" and _pre_UI_003)
      or post_UI_003(_lastU)

  /// UI-004: While on Dashboard, when the session expires, the system shall return to Login.
  val oblig_UI_004: bool =
    not(_lastAction == "session_expired" and _pre_UI_004)
      or post_UI_004

  // -- Witnesses: the step can happen -------------------------

  /// Witness for UI-001: While on Home, when the user clicks 'Sign in', the system shall navigate to Login.
  val witness_UI_001: bool =
    not(_lastAction == "click_sign_in"
        and _pre_UI_001
        and post_UI_001)

  /// Witness for UI-002: While on Login, when the user submits valid credentials, the system shall navigate to Dashboard.
  val witness_UI_002: bool =
    not(_lastAction == "submit_success"
        and _pre_UI_002
        and post_UI_002(_lastU, _lastS))

  /// Witness for UI-003: If the user submits credentials for a Locked account, then the system shall navigate to LockedNotice.
  val witness_UI_003: bool =
    not(_lastAction == "submit_locked"
        and _pre_UI_003
        and post_UI_003(_lastU))

  /// Witness for UI-004: While on Dashboard, when the session expires, the system shall return to Login.
  val witness_UI_004: bool =
    not(_lastAction == "session_expired"
        and _pre_UI_004
        and post_UI_004)

  // -- The same probes, the right way up ----------------------
  // For the simulator. `quint run --witnesses=<name>` counts the
  // runs in which a formula held at least once, and each probe above
  // is a negation, which holds at init. These count the runs that
  // reached each behavior: the vacuity pre-screen spec-record runs
  // before the model checker, and the example gate in CI.
  val reached_UI_001: bool = not(witness_UI_001)
  val reached_UI_002: bool = not(witness_UI_002)
  val reached_UI_003: bool = not(witness_UI_003)
  val reached_UI_004: bool = not(witness_UI_004)

}

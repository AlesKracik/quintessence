// ==========================================================
// Witness Probe Module: auth-ui
// GENERATED by tools/spec-probes.py — regenerate, never hand-edit.
// Source of predicates: the @req / @outcome-of doc comments in
// specs/auth-ui.qnt — each witness host's body, inlined here.
// Transition invariants: the @inv hosts over _prev* ghosts, same file.
//
// To prove a behavior is REACHABLE, assert its negation as an
// invariant — the checker's counterexample IS the witness trace.
//
// Each probe carries up to THREE conjuncts, and each closes a
// different way a witness can prove less than the requirement claims:
//   1. PATH CONSTRAINT (_lastAction == quint_ref) — the trace must
//      arrive via the requirement's own action.
//   2. DELTA over the _prev* ghosts — the pre-state the step had to
//      start from. Without it a predicate already true at init
//      witnesses green over nothing; spec-record refuses that trace
//      as HOLLOW.
//   3. PREDICATE, bound to the param ghosts.
// The path comes first so that at init — no action yet, every ghost
// still its zero — evaluation stops before reading a ghost as a key.
// ==========================================================

module authUi_probes {

  import authUi.* from "./auth-ui"

  // -- Ghost instrumentation ---------------------------------
  var _lastAction: str
  var _lastS: SessionId
  var _lastU: UserId
  var _prevCurrent: Screen

  action initP = all {
    init,
    _lastAction' = "init",
    _lastS' = "",
    _lastU' = "",
    _prevCurrent' = Home,
  }

  action stepP = {
    nondet s = oneOf(Set("s1", "s2"))
    nondet u = oneOf(Set("alice", "bob"))
    any {
      all { click_sign_in,
            _lastAction' = "click_sign_in",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _prevCurrent' = current,
      },
      all { submit_success(u, s),
            _lastAction' = "submit_success",
            _lastS' = s,
            _lastU' = u,
            _prevCurrent' = current,
      },
      all { submit_invalid(u),
            _lastAction' = "submit_invalid",
            _lastS' = _lastS,
            _lastU' = u,
            _prevCurrent' = current,
      },
      all { submit_locked(u),
            _lastAction' = "submit_locked",
            _lastS' = _lastS,
            _lastU' = u,
            _prevCurrent' = current,
      },
      all { click_logout,
            _lastAction' = "click_logout",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _prevCurrent' = current,
      },
      all { session_expired,
            _lastAction' = "session_expired",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _prevCurrent' = current,
      },
      all { go_home,
            _lastAction' = "go_home",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _prevCurrent' = current,
      },
      all { time_passes,
            _lastAction' = "time_passes",
            _lastS' = _lastS,
            _lastU' = _lastU,
            _prevCurrent' = current,
      },
    }
  }

  // -- Witness probes -----------------------------------------

  /// Witness probe for UI-001: While on Home, when the user clicks 'Sign in', the system shall navigate to Login.
  val witness_UI_001: bool =
    not(_lastAction == "click_sign_in"
        and _prevCurrent == Home
        and current == Login)

  /// Witness probe for UI-002: While on Login, when the user submits valid credentials, the system shall navigate to Dashboard.
  val witness_UI_002: bool =
    not(_lastAction == "submit_success"
        and _prevCurrent == Login
        and current == Dashboard and authenticated and mySession == _lastS)

  /// Witness probe for UI-003: If the user submits credentials for a Locked account, then the system shall navigate to LockedNotice.
  val witness_UI_003: bool =
    not(_lastAction == "submit_locked"
        and _prevCurrent == Login
        and current == LockedNotice and form == ErrorLocked and accountLocked(_lastU))

  /// Witness probe for UI-004: While on Dashboard, when the session expires, the system shall return to Login.
  val witness_UI_004: bool =
    not(_lastAction == "session_expired"
        and _prevCurrent == Dashboard
        and current == Login and not(authenticated))

  // -- The same probes, the right way up ----------------------
  // For the simulator. `quint run --witnesses=<name>` counts the
  // runs in which a formula held at least once, and each probe above
  // is a negation, which holds at init. These count the runs that
  // reached each behavior: the vacuity pre-screen spec-record runs
  // before the model checker, and the example gate in CI.
  val reached_UI_001: bool = not(witness_UI_001)
  val reached_UI_002: bool = not(witness_UI_002)
  val reached_UI_003: bool = not(witness_UI_003)
  val reached_UI_004: bool = not(witness_UI_004)

}

// ==========================================================
// Witness Probe Module: subscription
// GENERATED by tools/spec-probes.py — regenerate, never hand-edit.
// Source of predicates: the @req / @outcome-of doc comments in
// specs/subscription.qnt — each witness host's body, inlined here.
// Transition invariants: the @inv hosts over _prev* ghosts, same file.
//
// To prove a behavior is REACHABLE, assert its negation as an
// invariant — the checker's counterexample IS the witness trace.
//
// Each probe carries up to THREE conjuncts, and each closes a
// different way a witness can prove less than the requirement claims:
//   1. PATH CONSTRAINT (_lastAction == quint_ref) — the trace must
//      arrive via the requirement's own action.
//   2. DELTA over the _prev* ghosts — the pre-state the step had to
//      start from. Without it a predicate already true at init
//      witnesses green over nothing; spec-record refuses that trace
//      as HOLLOW.
//   3. PREDICATE, bound to the param ghosts.
// The path comes first so that at init — no action yet, every ghost
// still its zero — evaluation stops before reading a ghost as a key.
// ==========================================================

module subscription_probes {

  import subscription.* from "./subscription"

  // -- Ghost instrumentation ---------------------------------
  var _lastAction: str
  var _lastC: CustomerId
  var _lastN: Notice
  var _lastTimedOut: bool
  var _prevNotice: CustomerId -> Notice
  var _prevStatus: CustomerId -> SubStatus

  action initP = all {
    init,
    _lastAction' = "init",
    _lastC' = "",
    _lastN' = NoNotice,
    _lastTimedOut' = false,
    _prevNotice' = Map(),
    _prevStatus' = Map(),
  }

  action stepP = {
    nondet c = oneOf(Set("alice", "bob"))
    nondet n = oneOf(Set(Email, InApp))
    nondet timedOut = oneOf(Set(true, false))
    any {
      all { cancel_subscription(c, n),
            _lastAction' = "cancel_subscription",
            _lastC' = c,
            _lastN' = n,
            _lastTimedOut' = _lastTimedOut,
            _prevNotice' = notice,
            _prevStatus' = status,
      },
      all { cancel_declined(c),
            _lastAction' = "cancel_declined",
            _lastC' = c,
            _lastN' = _lastN,
            _lastTimedOut' = _lastTimedOut,
            _prevNotice' = notice,
            _prevStatus' = status,
      },
      all { cancel_unanswered(c, timedOut),
            _lastAction' = "cancel_unanswered",
            _lastC' = c,
            _lastN' = _lastN,
            _lastTimedOut' = timedOut,
            _prevNotice' = notice,
            _prevStatus' = status,
      },
      all { cancel_again(c),
            _lastAction' = "cancel_again",
            _lastC' = c,
            _lastN' = _lastN,
            _lastTimedOut' = _lastTimedOut,
            _prevNotice' = notice,
            _prevStatus' = status,
      },
      all { expire_period(c),
            _lastAction' = "expire_period",
            _lastC' = c,
            _lastN' = _lastN,
            _lastTimedOut' = _lastTimedOut,
            _prevNotice' = notice,
            _prevStatus' = status,
      },
      all { request_refund(c),
            _lastAction' = "request_refund",
            _lastC' = c,
            _lastN' = _lastN,
            _lastTimedOut' = _lastTimedOut,
            _prevNotice' = notice,
            _prevStatus' = status,
      },
    }
  }

  // -- Witness probes -----------------------------------------

  /// Witness probe for REQ-001: When a customer cancels an Active subscription, the system shall stop future billing.
  val witness_REQ_001: bool =
    not(_lastAction == "cancel_subscription"
        and _prevStatus.get(_lastC) == Active
        and status.get(_lastC) == Cancelled and not(billingEnabled.get(_lastC)))

  /// Witness probe for REQ-002: While the paid period has not ended, the system shall keep access available to a cancelled subscriber.
  val witness_REQ_002: bool =
    not(_lastAction == "cancel_subscription"
        and _prevStatus.get(_lastC) == Active
        and status.get(_lastC) == Cancelled and accessUntilPeriodEnd.get(_lastC))

  /// Witness probe for REQ-003: When a customer cancels an already-Cancelled subscription, the system shall make no further change.
  val witness_REQ_003: bool =
    not(_lastAction == "cancel_again"
        and _prevStatus.get(_lastC) == Cancelled
        and status.get(_lastC) == Cancelled and accessUntilPeriodEnd.get(_lastC))

  /// Witness probe for REQ-004: If the billing provider does not answer a cancellation, then the system shall leave the subscription Active.
  val witness_REQ_004: bool =
    not(_lastAction == "cancel_unanswered"
        and _prevStatus.get(_lastC) == Active
        and (lastBillingResult.get(_lastC) == Timeout or lastBillingResult.get(_lastC) == NetworkError) and status.get(_lastC) == Active and billingEnabled.get(_lastC))

  /// Witness probe for REQ-005: When the paid period ends for a cancelled subscription, the system shall withdraw access.
  val witness_REQ_005: bool =
    not(_lastAction == "expire_period"
        and _prevStatus.get(_lastC) == Cancelled
        and status.get(_lastC) == Expired and not(accessUntilPeriodEnd.get(_lastC)))

  /// Witness probe for REQ-007 / email: When a cancellation succeeds, the system shall confirm it to the customer.
  val witness_REQ_007_email: bool =
    not(_lastAction == "cancel_subscription"
        and _prevNotice.get(_lastC) == NoNotice
        and (notice.get(_lastC) == Email) and not(notice.get(_lastC) == InApp))

  /// Witness probe for REQ-007 / in-app: When a cancellation succeeds, the system shall confirm it to the customer.
  val witness_REQ_007_in_app: bool =
    not(_lastAction == "cancel_subscription"
        and _prevNotice.get(_lastC) == NoNotice
        and (notice.get(_lastC) == InApp) and not(notice.get(_lastC) == Email))

  /// Witness probe for REQ-008: If the billing provider declines a cancellation, then the system shall leave the subscription Active.
  val witness_REQ_008: bool =
    not(_lastAction == "cancel_declined"
        and _prevStatus.get(_lastC) == Active
        and lastBillingResult.get(_lastC) == Declined and status.get(_lastC) == Active and billingEnabled.get(_lastC))

  // -- The same probes, the right way up ----------------------
  // For the simulator. `quint run --witnesses=<name>` counts the
  // runs in which a formula held at least once, and each probe above
  // is a negation, which holds at init. These count the runs that
  // reached each behavior: the vacuity pre-screen spec-record runs
  // before the model checker, and the example gate in CI.
  val reached_REQ_001: bool = not(witness_REQ_001)
  val reached_REQ_002: bool = not(witness_REQ_002)
  val reached_REQ_003: bool = not(witness_REQ_003)
  val reached_REQ_004: bool = not(witness_REQ_004)
  val reached_REQ_005: bool = not(witness_REQ_005)
  val reached_REQ_007_email: bool = not(witness_REQ_007_email)
  val reached_REQ_007_in_app: bool = not(witness_REQ_007_in_app)
  val reached_REQ_008: bool = not(witness_REQ_008)

  // No probe, by design or because one is owed:
  //   REQ-006: forbidden — proof is INV-002

}

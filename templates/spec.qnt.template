// ============================================================
// Quint Specification: {{AREA}}
// Intent: specs/{{AREA}}.intent.json · ledger: specs/{{AREA}}.records.json
// Last modified: {{DATE}}
//
// Structure convention used by /spec when drafting a model.
// QUINT-FIRST: every record lives HERE, as a `///` doc comment on
// the declaration that realizes it (grammar: tools/spec_source.py):
//   @req  on the action it governs (formal @while / @shall), on the
//         pure def it computes, or on the module while still raw
//   @inv  on its val      @prop on its temporal
//   @con  on its pure val (the literal IS the value)
//   @example on its run
// Witness probes live in the separate generated
// specs/{{AREA}}.probes.qnt.
// ============================================================

module {{MODULE_NAME}} {

  // ----------------------------------------------------------
  // TYPES
  // Define all domain types before state variables.
  // Each type corresponds to a domain concept from requirements.
  // ----------------------------------------------------------

  // {{TYPE_DEFINITIONS}}
  // Example:
  //   type UserId = str
  //   type Status = Active | Inactive | Suspended
  //
  // One alias PER VALUE DOMAIN, even when they are all strings:
  //   type Role = str     type Coll = str     type Id = str
  // formal_model.probe_domains is keyed by type, so parameters
  // that all say `str` would draw role, collection and id from
  // one set. (Or key one parameter: "param:role": "Set(...)".)


  // ----------------------------------------------------------
  // STATE
  // One var per independent piece of mutable state.
  // Derived values should be val (pure functions), not var.
  // ----------------------------------------------------------

  // {{STATE_VARIABLES}}
  // Example:
  //   var users: UserId -> UserRecord      // REQ-001
  //   var sessionCount: int                // CON-002
  //
  // A single record var is fine too — the shape a conformance
  // adapter with st()/last() getters has:
  //   type State = { users: UserId -> UserRecord, count: int }
  //   var st: State
  // Probe ghosts (_prevSt) are initialized field by field; a sum
  // type to its FIRST variant. For a type with no buildable zero
  // (parameterized, recursive) declare formal_model.ghost_zeros.


  // ----------------------------------------------------------
  // CHECKING COST
  // A model is checked in a loop, so how long a check takes
  // decides how often it is run. Model with the SMALLEST domains
  // that still tell apart the behaviors you care about: one
  // element per distinction a requirement makes.
  //   two group ids      — to tell "this group" from "another"
  //   one case pair      — "gold"/"GOLD" shows case-insensitivity
  //   versions {0, 1}    — enough to show "stale"
  // Shapes that cost the most, each with a rewrite that keeps
  // the meaning (tools/spec-lint.py <area> --cost reports them):
  //   a map grown with `put` from Map()  -> a total map over the
  //     key domain with an `exists: bool` field (or a status)
  //   `oneOf(S.powerset())`              -> a smaller S, or the
  //     few subsets that matter, listed
  //   an int only ever incremented, read only as `== before + 1`
  //     -> a bool "changed by the last step"
  //   many parameters on one action      -> its branching is the
  //     product of their domains; drop or narrow the ones no
  //     requirement distinguishes
  // Parameter names are free: probe ghosts are allocated by
  // type position, so `items` and `newItems` share one.
  // ----------------------------------------------------------


  // ----------------------------------------------------------
  // CONSTANTS / PARAMETERS
  // Bounds and configuration used in model checking. Use
  // `pure val NAME: type = literal` — the literal IS the
  // constraint's value; its record carries only what the model
  // cannot say.
  // ----------------------------------------------------------

  // {{CONSTANTS}}
  // Example:
  //   /// @con CON-003
  //   /// Most concurrent sessions per user.
  //   /// @unit sessions
  //   /// @pairs INV-002
  //   pure val MAX_SESSIONS: int = 5


  // ----------------------------------------------------------
  // HELPERS
  // Pure functions (val) that compute derived state.
  // Keep actions thin — push logic into helpers.
  // ----------------------------------------------------------

  // {{HELPER_DEFINITIONS}}
  //
  // Shared logic is a `def` / `pure def`, never an `action`:
  //   pure def commit(s: State, s1: State): State = s1
  //   pure def refuse(s: State, r: Result): { st: State, last: Result } =
  //     { st: s, last: r }
  // The probe generator mirrors only the actions `step` calls; a
  // helper written as an action gets no branch, and a requirement
  // on it is refused.
  //
  // A COMPUTED requirement (derived value, no transition) sits on
  // the pure def that computes it, verified by a unit test:
  //   /// @req REQ-NNN
  //   /// The system shall compute effort as the sum of issue effort.
  //   /// @status specified
  //   /// @verified-by src/utils/__tests__/score.test.ts
  //   pure def effort(xs: List[int]): int = xs.foldl(0, (a, b) => a + b)


  // ----------------------------------------------------------
  // INITIAL STATE  (action init)
  // Must establish all invariants from the start.
  // ----------------------------------------------------------

  action init = {
    // {{INIT_BODY}}
    // Example:
    //   users' = Map()
    //   sessionCount' = 0
    all {
      true // replace with actual initial conditions
    }
  }


  // ----------------------------------------------------------
  // ACTIONS (state transitions)
  // Each action corresponds to one or more REQ-* items.
  // Guards encode CON-* constraints.
  //
  // IDIOM: Quint has no `require`. A guard is a BARE BOOLEAN
  // conjunct inside `all { ... }`. Nor is there a builtin
  // `getOrElse`: `m.get(k)` is undefined on an absent key, so
  // guard it with `if (m.keys().contains(k)) m.get(k) else <d>`.
  // A `{ ... }` body may bind local `val`s and then yield ONE
  // expression — bare statements in a block are a parse error.
  //
  // Only ROUTE-LEVEL operations are actions (one per entry
  // point `step` calls); shared logic is a def (see HELPERS).
  //
  // Built-in names cannot be reused for helpers (QNT101) —
  // exists, forall, map, filter, fold, foldl, foldr, keys, get,
  // set, put, setBy, mapBy, contains, in, union, intersect,
  // exclude, subseteq, size, powerset, flatten, oneOf,
  // chooseSome, append, concat, head, tail, length, nth,
  // indices, range, select, slice, replaceAt, then, expect,
  // reps, fail, assert, iff, implies, not, and, or, next,
  // always, eventually, with, field, fieldNames, label, item.
  // Name the helper for what it asks: hasEntity, entityIn.
  // ----------------------------------------------------------

  // {{ACTION_DEFINITIONS}}
  // Template for each action. A REQUIREMENT sits on the action it
  // governs. @while is a Quint boolean over the state BEFORE the
  // step, @shall over the state AFTER, both over the action's own
  // parameter names. /spec-check proves every step of the action
  // from @while ends in @shall (the obligation), and that such a
  // step can happen (the witness). Never name a _-ghost here.
  //
  // /// @req REQ-NNN
  // /// <the sentence, in the user's words>
  // /// @status specified
  // /// @when <trigger, in words: the trigger IS this action>
  // /// @while <Quint: pre-state condition>
  // /// @old before: <Type> = <Quint over the pre-state>
  // /// @shall <Quint: post-state condition; may name `before`>
  // /// @refs REQ-001, DEC-002, billing.REQ-004
  // ///   (bare ID = this area; <area>.<ID> = another; any kind)
  // ///
  // /// @req REQ-NNN
  // /// <a permission: the system MAY do one of several things>
  // /// @modality may
  // /// @outcome <name>: <Quint: post-state for this outcome>
  // /// @outcome <name>: <Quint: post-state for that outcome>
  // ///
  // /// @req REQ-NNN
  // /// <a prohibition: this step must never happen while ...>
  // /// @modality forbidden
  // /// @unwanted
  // /// @while <Quint: when it is forbidden>
  // action {{ACTION_NAME}}({{PARAMS}}): bool = all {
  //   {{PRECONDITION}},          // CON-NNN guard, a plain boolean
  //   {{STATE_UPDATES}}
  // }
  //
  // ...and an EXAMPLE shows the refusal: reach the blocking state,
  // assert it, and END with the call .fail(). Nothing can follow .fail():
  // Quint assigns no state after it (a refused step changes nothing in the
  // model; replay checks the code changes nothing either).
  //
  // /// @example EX-NNN
  // /// <the refused case, in the user's words>
  // /// @refs REQ-NNN
  // run {{REFUSAL_RUN}} = init
  //   .then({{REACH_BLOCKING_STATE}})
  //   .expect({{BLOCKING_STATE_HOLDS}})
  //   .then({{ACTION_NAME}}({{ARGS}}).fail())
  //
  // With a local binding:
  //
  // action {{ACTION_NAME}}({{PARAMS}}): bool = {
  //   val {{LOCAL}} = <expression>
  //   all {
  //     {{PRECONDITION}},
  //     {{STATE_UPDATES}}
  //   }
  // }


  // ----------------------------------------------------------
  // STEP (composite action for model checking)
  // Enumerates all possible transitions in one step.
  // ----------------------------------------------------------

  action step = {
    any {
      // {{LIST_ALL_ACTIONS_HERE}}
      // Example:
      //   {{ACTION_NAME1}}(...),
      //   {{ACTION_NAME2}}(...),
    }
  }


  // ----------------------------------------------------------
  // SAFETY INVARIANTS (INV-*)
  //
  // Every numeric CON-* an action reads needs an invariant
  // bounding it from the OTHER side (constraints[].paired_invariant).
  // A witness proves the threshold CAN fire; nothing proves it
  // cannot fire early, so `>= MAX` loosened to `>= 1` passes every
  // other gate. The paired invariant is what notices:
  //   val noEarly{{THING}}: bool =
  //     counter.keys().forall(k =>
  //       (counterOf(k) < {{MAX_CONST}}) implies not(triggered(k)))
  // Must hold in every reachable state.
  // Apalache will try to find a state where these are false.
  // ----------------------------------------------------------

  // {{INVARIANT_DEFINITIONS}}
  // Template:
  //
  // /// @inv INV-NNN
  // /// <the invariant, in words>
  // /// @criticality critical
  // val {{INV_NAME}}: bool = {{FORMULA}}
  //
  // A TRANSITION property (needs the pre-state) is a def whose
  // parameters are the probe module's _prev* ghosts; the probe
  // generator emits its body there as `val <quint-name>`:
  //
  // /// @inv INV-NNN
  // /// <X never changes>
  // /// @quint-name {{INV_NAME}}
  // def {{INV_NAME}}_over(_prevX: <type of x>): bool = x == _prevX
  //
  // The def's name and @quint-name MUST differ (hence `_over`):
  // the probe module imports this module and declares
  // `val {{INV_NAME}}`, so a shared name does not compile.


  // ----------------------------------------------------------
  // LIVENESS / TEMPORAL PROPERTIES (PROP-*)
  // Things that must eventually become true or always cycle.
  // These require temporal model checking (CTL/LTL).
  // ----------------------------------------------------------

  // {{TEMPORAL_DEFINITIONS}}
  // Template:
  //
  // /// @prop PROP-NNN
  // /// <what eventually happens>
  // temporal {{PROP_NAME}} = {{TEMPORAL_FORMULA}}


  // ----------------------------------------------------------
  // TESTS (simulation traces for sanity checking)
  // Run with: quint test specs/{{AREA}}/spec.qnt
  // ----------------------------------------------------------

  // {{TEST_DEFINITIONS}}
  // Template (a worked example IS its run):
  //
  // /// @example EX-NNN
  // /// <title>
  // /// @refs REQ-NNN
  // /// @source elicited
  // run {{TEST_NAME}} = {
  //   init.then({{ACTION_SEQUENCE}}).expect({{EXPECTED_CONDITION}})
  // }
  //
  // The trailing .expect(...) IS the example's expectation — no
  // @expect tag needed. `@expect {json}` is only for an example
  // hosted on an action (no run yet).

}

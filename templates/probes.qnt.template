// ============================================================
// Witness Probe Module: {{AREA}}
// GENERATED by /spec-check — regenerate, never hand-edit.
// Source: each requirement's @while / @old / @shall / @outcome,
// on the action it governs in specs/{{AREA}}.qnt
//
// How it works: to prove a behavior is REACHABLE, we assert its
// negation as an invariant. The model checker's counterexample
// is then a step-by-step trace WHERE THE BEHAVIOR HAPPENS — the
// witness. Saved as specs/{{AREA}}/traces/<REQ-ID>.itf.json.
//
//   quint verify --invariant=witness_{{REQ_ID}} \
//     --out-itf=specs/{{AREA}}/traces/{{REQ_ID}}.itf.json \
//     specs/{{AREA}}.probes.qnt
//
// "Violation found"  => WITNESSED (good — trace saved)
// "No violation"     => NO WITNESS (bad — behavior unreachable;
//                       impossible guard, missing action, or
//                       --max-steps bound too small)
// ============================================================

module {{MODULE_NAME}}_probes {

  import {{MODULE_NAME}}.* from "./{{AREA}}"

  // ----------------------------------------------------------
  // GHOST INSTRUMENTATION
  // _lastAction — which action produced the current state.
  // Param ghosts (one per parameter TYPE POSITION: the k-th
  // parameter of that type in an action's signature) — the
  // arguments that action was called with. Allocated by type
  // position so the ghost count does not depend on parameter
  // names; spec-record writes every trace back under
  // _last<Param> names, which is what the replay harness reads
  // (without them it would have to infer call arguments from
  // state diffs — fragile).
  // Every probe run uses:  --init=initP --step=stepP
  // ----------------------------------------------------------

  var _lastAction: str
  // {{PARAM_GHOSTS}}  e.g.:
  // var _arg_UserId_1: UserId     // login.uid, unlock.uid
  // var _arg_SessionId_1: SessionId  // login.sid, logout.sid
  //
  //
  // {{PRE_GHOSTS}} — one per requirement: its @while, evaluated
  // BEFORE the step over the step's own arguments:
  // var _pre_REQ_003: bool
  // {{OLD_GHOSTS}} — one per @old snapshot:
  // var _old_REQ_003_before: int
  // {{PREV_GHOSTS}} — one per state var a transition invariant reads:
  // var _prevSessions: SessionId -> SessionStatus

  // Ghost initial values are written EXPLICITLY, never `= <var>`:
  // before init there is no prior state to read.
  action initP = all { init, _lastAction' = "init" /*, _arg_UserId_1' = "",
                       _prevSessions' = Map(), ... */ }

  action stepP = {
    // Mirror the area module's step, tagging each branch with the
    // action name and its parameters (identity-assign ghosts the
    // branch doesn't use):
    nondet arg_UserId_1 = oneOf(USERS)
    any {
      // all { login(arg_UserId_1, arg_SessionId_1), _lastAction' = "login",
      //       _arg_UserId_1' = arg_UserId_1,  _arg_SessionId_1' = arg_SessionId_1,
      //       _pre_REQ_005' = pre_REQ_005(arg_UserId_1, arg_SessionId_1),
      //       _prevSessions' = sessions },
      // all { logout(arg_SessionId_1), _lastAction' = "logout",
      //       _arg_UserId_1' = _arg_UserId_1, _arg_SessionId_1' = arg_SessionId_1,
      //       _prevSessions' = sessions },
      // ... one branch per action `step` calls (helper actions
      //     are not mirrored — write shared logic as a def);
      //     every branch assigns EVERY ghost, identity-assigning
      //     the ones it doesn't use ...
    }
  }

  // ----------------------------------------------------------
  // REQUIREMENT DEFS — the authored clauses, as defs over the
  // action's OWN parameter names, so no text is substituted:
  //
  // def pre_REQ_003(uid: UserId): bool = not(isLocked(uid))
  // def old_REQ_003_before(uid: UserId): int = attemptsOf(uid)
  // def post_REQ_003(uid: UserId, before: int): bool =
  //   attemptsOf(uid) == before + 1 and ...
  //
  // stepP evaluates pre_/old_ BEFORE the step (from unprimed
  // state) into the ghosts; post_ is called AFTER it with the
  // slot ghosts of that action and the _old ghosts.
  // ----------------------------------------------------------

  // ----------------------------------------------------------
  // OBLIGATIONS — every reachable step (checked as invariants)
  //
  // must:      not(_lastAction == "A" and _pre_R) or post_R(...)
  // may:       not(_lastAction == "A" and _pre_R)
  //              or outcome_R_x(...) or outcome_R_y(...)
  // forbidden: not(_lastAction == "A" and _pre_R)
  //
  // val oblig_{{REQ_ID}}: bool = ...
  //
  // A counterexample is a step of the action that breaks the
  // requirement: specs/{{AREA}}/traces/{{REQ_ID}}.violation.itf.json
  // ----------------------------------------------------------

  // ----------------------------------------------------------
  // WITNESSES — the step can happen (negated; the counterexample
  // is the witness trace). The path conjunct comes first: at init
  // no action has run and every ghost is its zero, so evaluation
  // stops before a ghost is read as a map key.
  //
  // val witness_{{REQ_ID}}: bool =
  //   not(_lastAction == "{{QUINT_REF}}" and _pre_{{REQ_ID}}
  //       and post_{{REQ_ID}}(_arg_UserId_1, _old_{{REQ_ID}}_before))
  //
  // A `may` gets one per outcome, each with the other outcomes
  // false. A `forbidden` or computed requirement gets none.
  //
  // and, after all the probes, the same probe the right way up — what
  // `quint run --witnesses` counts:
  //
  // val reached_{{REQ_ID}}: bool = not(witness_{{REQ_ID}})
  //
  // Run with:
  //   quint verify --invariant=witness_{{REQ_ID}} \
  //     --init=initP --step=stepP \
  //     --out-itf=specs/{{AREA}}/traces/{{REQ_ID}}.itf.json \
  //     specs/{{AREA}}.probes.qnt

  // ----------------------------------------------------------
  // TRANSITION INVARIANTS — one per invariant with over: "probes"
  // A property of a STEP, not of a state: "X never changes", "Y
  // only moves one way", "DELETED is terminal". It lives here
  // because the _prev* ghosts it reads exist only here. It is
  // authored in the model as a def whose parameters ARE those
  // ghosts (so it typechecks there); its body is emitted here. Not `always(P(next(x)))`: quint
  // compiles that to [](x = x'), which TLA+ rejects — it wants
  // box-action form [][A]_vars.
  //
  // Emitted POSITIVELY, unlike a probe: a probe is negated so its
  // counterexample is the witness, while a counterexample to one
  // of these is a VIOLATION.
  //
  // /// {{INV_ID}}: <invariant description>
  // val {{INV_QUINT_NAME}}: bool =
  //   {{INV_PREDICATE}}
  //
  // e.g.  val policyStable: bool =
  //         groups.keys().forall(g =>
  //           groups.get(g).policy == _prevGroups.get(g).policy)
  //
  // Run with (same --init/--step as a probe, asserted directly):
  //   quint verify --invariant={{INV_QUINT_NAME}} \
  //     --init=initP --step=stepP specs/{{AREA}}.probes.qnt
  // ----------------------------------------------------------

  // Action coverage falls out of the witness probes (each is
  // path-constrained on _lastAction == quint_ref, so a witnessed
  // REQ proves its action fires). Unreferenced actions are
  // flagged statically by spec-lint (orphan-action), which asks
  // whether the model can REACH an action, so per-branch step
  // wrappers count as live — no extra
  // probes needed.

  // ----------------------------------------------------------
  // UI / CONTRACT AREAS (multi-module probes)
  // A ui or contract area's requirements span this module AND the
  // areas it imports. Pattern: import every spanned module, make
  // stepP an `any` over ALL modules' wrapped actions (so joint
  // behaviors are explored); @while / @shall then range over
  // the joint state:
  //
  //   import auth.* from "./auth"
  //   import authUi.* from "./auth-ui"
  //   action stepP = any {
  //     all { login(uid, sid),   _lastAction' = "auth::login", ... },
  //     all { submit_success,    _lastAction' = "ui::submit_success", ... },
  //   }
  //   val witness_UI_002: bool =
  //     not(current == Dashboard and _lastAction == "ui::submit_success")
  // ----------------------------------------------------------
}

// ============================================================
// Witness Probe Module: {{AREA}}
// GENERATED by /spec-check — regenerate, never hand-edit.
// Source of predicates: requirements[].witness.predicate in
// specs/{{AREA}}.json
//
// How it works: to prove a behavior is REACHABLE, we assert its
// negation as an invariant. The model checker's counterexample
// is then a step-by-step trace WHERE THE BEHAVIOR HAPPENS — the
// witness. Saved as specs/{{AREA}}/traces/<REQ-ID>.itf.json.
//
//   quint verify --invariant=witness_{{REQ_ID}} \
//     --out-itf=specs/{{AREA}}/traces/{{REQ_ID}}.itf.json \
//     specs/{{AREA}}.probes.qnt
//
// "Violation found"  => WITNESSED (good — trace saved)
// "No violation"     => NO WITNESS (bad — behavior unreachable;
//                       impossible guard, missing action, or
//                       --max-steps bound too small)
// ============================================================

module {{MODULE_NAME}}_probes {

  import {{MODULE_NAME}}.* from "./{{AREA}}"

  // ----------------------------------------------------------
  // GHOST INSTRUMENTATION
  // _lastAction — which action produced the current state.
  // Param ghosts (one per distinct action parameter) — the
  // arguments that action was called with. The replay harness
  // reads these from the trace; without them it would have to
  // infer call arguments from state diffs (fragile).
  // Every probe run uses:  --init=initP --step=stepP
  // ----------------------------------------------------------

  var _lastAction: str
  // {{PARAM_GHOSTS}}  e.g.:
  // var _lastUid: str
  // var _lastSid: str
  //
  // {{PREV_GHOSTS}} — one per state var some witness.delta reads.
  // These snapshot the PRE-state so a probe can require that the
  // step actually moved something:
  // var _prevSessions: SessionId -> SessionStatus

  // Ghost initial values are written EXPLICITLY, never `= <var>`:
  // before init there is no prior state to read.
  action initP = all { init, _lastAction' = "init" /*, _lastUid' = "",
                       _prevSessions' = Map(), ... */ }

  action stepP = {
    // Mirror the area module's step, tagging each branch with the
    // action name and its parameters (identity-assign ghosts the
    // branch doesn't use):
    nondet uid = oneOf(USERS)
    any {
      // all { login(uid, sid), _lastAction' = "login",
      //       _lastUid' = uid,  _lastSid' = sid,
      //       _prevSessions' = sessions },
      // all { logout(sid),     _lastAction' = "logout",
      //       _lastUid' = _lastUid, _lastSid' = sid,
      //       _prevSessions' = sessions },
      // ... one branch per action; every branch assigns EVERY
      //     ghost, identity-assigning the ones it doesn't use ...
    }
  }

  // ----------------------------------------------------------
  // WITNESS PROBES — one per requirement, THREE conjuncts each.
  // Negation of (predicate AND _lastAction == quint_ref AND delta).
  //
  // 1. PREDICATE, BOUND to the param ghosts. Binding is what makes
  //    the witness about this call: `_lastAction == login` pins
  //    which action ran last, not that it caused the postcondition,
  //    so a bare existential — "some session is Active" — is
  //    satisfied by a session an unrelated call created, and the
  //    requirement goes green while its own action misbehaves.
  //    Write `statusOf(sessions, _lastSid) == Active`, not
  //    `sessions.keys().exists(s => ...)`.
  //
  // 2. PATH CONSTRAINT (_lastAction == quint_ref): the trace must
  //    reach the postcondition VIA the requirement's own action.
  //    Omit only when the requirement has no quint_ref.
  //
  // 3. DELTA (witness.delta.pre, over the _prev* ghosts): the
  //    pre-state the step had to start from. Reachability alone is
  //    not causation — a guard that already implies its own
  //    postcondition makes the action a no-op that fires only once
  //    its result holds, and the probe witnesses green over dead
  //    text. The delta forces the trace to show state MOVING.
  // ----------------------------------------------------------

  // {{WITNESS_PROBES}}
  // Template per requirement:
  //
  // /// Witness probe for {{REQ_ID}}: <requirement description>
  // /// predicate: <witness.predicate verbatim>
  // val witness_{{REQ_ID}}: bool =
  //   not(({{WITNESS_PREDICATE}})
  //       and _lastAction == "{{QUINT_REF}}"
  //       and ({{WITNESS_DELTA_PRE}}))
  //
  // A rejection requirement gets NO probe: a prohibition has no
  // reachable state to witness. Its model-side proof is the
  // invariant named in witness.enforced_by, and its code-side
  // evidence is the artifact in requirements[].refusal — replay
  // never covers it, because replay only replays witness traces.
  //
  // Run with:
  //   quint verify --invariant=witness_{{REQ_ID}} \
  //     --init=initP --step=stepP \
  //     --out-itf=specs/{{AREA}}/traces/{{REQ_ID}}.itf.json \
  //     specs/{{AREA}}.probes.qnt

  // ----------------------------------------------------------
  // TRANSITION INVARIANTS — one per invariant with over: "probes"
  // A property of a STEP, not of a state: "X never changes", "Y
  // only moves one way", "DELETED is terminal". It lives here
  // because the _prev* ghosts it reads exist only here, and it is
  // authored in the area JSON (invariants[].predicate) because
  // this module is generated. Not `always(P(next(x)))`: quint
  // compiles that to [](x = x'), which TLA+ rejects — it wants
  // box-action form [][A]_vars.
  //
  // Emitted POSITIVELY, unlike a probe: a probe is negated so its
  // counterexample is the witness, while a counterexample to one
  // of these is a VIOLATION.
  //
  // /// {{INV_ID}}: <invariant description>
  // val {{INV_QUINT_NAME}}: bool =
  //   {{INV_PREDICATE}}
  //
  // e.g.  val policyStable: bool =
  //         groups.keys().forall(g =>
  //           groups.get(g).policy == _prevGroups.get(g).policy)
  //
  // Run with (same --init/--step as a probe, asserted directly):
  //   quint verify --invariant={{INV_QUINT_NAME}} \
  //     --init=initP --step=stepP specs/{{AREA}}.probes.qnt
  // ----------------------------------------------------------

  // Action coverage falls out of the witness probes (each is
  // path-constrained on _lastAction == quint_ref, so a witnessed
  // REQ proves its action fires). Unreferenced actions are
  // flagged statically by spec-lint (orphan-action), which asks
  // whether the model can REACH an action, so per-branch step
  // wrappers count as live — no extra
  // probes needed.

  // ----------------------------------------------------------
  // UI / CONTRACT AREAS (multi-module probes)
  // A ui or contract area's predicates span this module AND the
  // areas it imports. Pattern: import every spanned module, make
  // stepP an `any` over ALL modules' wrapped actions (so joint
  // behaviors are explored), and write witness predicates over
  // the joint state:
  //
  //   import auth.* from "./auth"
  //   import authUi.* from "./auth-ui"
  //   action stepP = any {
  //     all { login(uid, sid),   _lastAction' = "auth::login", ... },
  //     all { submit_success,    _lastAction' = "ui::submit_success", ... },
  //   }
  //   val witness_UI_002: bool =
  //     not(current == Dashboard and _lastAction == "ui::submit_success")
  // ----------------------------------------------------------
}

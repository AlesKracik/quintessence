  ((s.accountStatus.keySet).all (fun uid => (!(auth.isLocked s uid) || (((auth.activeSessionsOf s uid).size) == (0 : Int)))))

def authenticated (s : State) : Bool :=
  (auth.isActive s s.mySession)

def guardedDashboard (s : State) : Bool :=
